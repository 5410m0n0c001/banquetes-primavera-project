  "activities": [
    {
      "source": "cronograma_html",
      "title": "Inicio y Corte de Listón",
      "desc": "Ceremonia de inauguración oficial del evento con palabras de bienvenida por parte de los organizadores y patrocinadores oficiales."
    },
    {
      "source": "cronograma_html",
      "title": "Apertura y Recorrido de Stands",
      "desc": "Apertura general de la zona de exhibición. Tiempo ideal para que los visitantes conozcan a los proveedores, coticen y participen en las dinámicas de los stands."
    },
    {
      "source": "cronograma_html",
      "title": "Saxofonista en Vivo",
      "desc": "Presentación musical elegante en el escenario principal, perfecta para dar una atmósfera sofisticada a cócteles y banquetes."
    },
    {
      "source": "cronograma_html",
      "title": "Espectáculo de Marimba",
      "desc": "Interpretaciones acústicas folclóricas llenas de alegría y tradición para amenizar la tarde de todos los asistentes."
    },
    {
      "source": "cronograma_html",
      "title": "Showcase en Vivo: Banda Instrumental",
      "desc": "Paola presenta un espectacular performance de danza por la Academia JHANADE para acompañar el atardecer."
    },
    {
      "source": "cronograma_html",
      "title": "Showcase en Vivo: Grupo Bonanza",
      "desc": "La pasarela estelar y performance de moda de primavera dedicado a las quinceañeras, presentado y producido por Dance Queens a cargo del profesor Humberto Núñez. Conoce las últimas tendencias de vestidos de 15 años con alta costura exclusiva."
    },
    {
      "source": "cronograma_html",
      "title": "Showcase en Vivo: Banda Lago Negro",
      "desc": "Reunión de todos los expositores en el escenario principal para capturar la fotografía oficial del recuerdo de la Expo Boda y 15 Años."
    }
  ]
